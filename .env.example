# Local PostgreSQL. If changing the password and port, also update DATABASE_URL.
POSTGRES_PASSWORD=local-openasset
POSTGRES_PORT=5432
DATABASE_URL=postgresql://openasset:local-openasset@127.0.0.1:5432/openasset
# Generate a unique secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Local-only opt-in for fictional users and inventory. Use a dedicated database.
OPENASSET_DEMO_SEED=false
OPENASSET_DEMO_ADMIN_PASSWORD=
OPENASSET_DEMO_STAFF_PASSWORD=
# Optional fresh database with the migration already applied for integration tests.
TEST_DATABASE_URL=
